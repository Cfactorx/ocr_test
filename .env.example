# OCR service configuration (copy to .env and adjust as needed)
# All variables are optional; defaults let image OCR work with zero config.

# Ollama endpoint and default vision model
OCR_OLLAMA_URL=http://localhost:11434/api/generate
OCR_DEFAULT_MODEL=gemma4:31b-cloud

# Where labels/knowledge-base live (default: <repo>/data)
# OCR_DATA_DIR=E:\data
# Where rolling logs go (default: <repo>/logs)
# OCR_LOG_DIR=E:\logs

# Poppler bin dir for PDF -> image (required for PDF input on Windows)
# OCR_POPPLER_PATH=D:\poppler\Library\bin

# Network binding (default 127.0.0.1 — only this machine)
# To share on LAN: set OCR_HOST=0.0.0.0 AND extend CORS:
# OCR_HOST=0.0.0.0
# OCR_CORS_ORIGINS=http://localhost:5500,http://192.168.3.10:5500

# OCR_PORT=8080
# OCR_MAX_UPLOAD_MB=20
